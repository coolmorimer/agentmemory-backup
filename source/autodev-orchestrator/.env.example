AUTODEV_ENVIRONMENT=development
AUTODEV_DATABASE_URL=postgresql+asyncpg://autodev:autodev@localhost:5432/autodev
AUTODEV_REDIS_URL=redis://localhost:6379/0
AUTODEV_OLLAMA_BASE_URL=http://localhost:11434
AUTODEV_LITELLM_BASE_URL=http://localhost:4000
AUTODEV_AGENTMEMORY_BASE_URL=http://localhost:3111
AUTODEV_CODEX_EXECUTABLE=codex
# 32-byte url-safe base64 key used only to encrypt provider credentials at rest.
# Generate it with: .\scripts\bootstrap-secrets.ps1
AUTODEV_CREDENTIAL_KEY=
AUTODEV_ALLOW_PAID_MODELS=false
AUTODEV_MAX_CLOUD_COST_USD_DAY=0
AUTODEV_MAX_CLOUD_COST_USD_MONTH=0

# Optional provider credentials. Keep values only in .env or a secret manager.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_API_TOKEN=
SAMBANOVA_API_KEY=
CEREBRAS_API_KEY=
FIREWORKS_API_KEY=
HUGGINGFACE_API_KEY=
